{
  "type": "module",
  "license": "GPL-3.0",
  "version": "2.2.33",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc && node scripts/verify-plugin-contracts.mjs && vite build && node scripts/verify-build-artifacts.mjs && theme-package",
    "build-only": "tsc && node scripts/verify-plugin-contracts.mjs && vite build && node scripts/verify-build-artifacts.mjs",
    "dev": "vite build --watch",
    "lint": "eslint ./src --ext .js,.cjs,.mjs,.ts,.cts,.mts --ignore-pattern src/static/qrcode/qrcode.min.js",
    "format": "prettier --write './**/*.{ts,json,yaml,yml,html}'",
    "prepare": "husky",
    "prettier": "prettier --write './**/*.{ts,json,yaml,yml,html}'",
    "verify:plugins": "node scripts/verify-plugin-pages.mjs",
    "verify:plugins:deep": "VERIFY_PLUGIN_DEEP=1 node scripts/verify-plugin-pages.mjs",
    "verify:build-artifacts": "node scripts/verify-build-artifacts.mjs",
    "verify:plugin-versions": "node scripts/check-plugin-versions.mjs",
    "verify:plugin-contracts": "node scripts/verify-plugin-contracts.mjs"
  },
  "lint-staged": {
    "*.{ts,json,yaml,yml,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@iconify/tailwind4": "^1.2.3",
    "@swup/head-plugin": "^2.3.1",
    "@swup/scripts-plugin": "^2.1.0",
    "alpinejs": "^3.15.11",
    "swup": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@halo-dev/theme-package-cli": "^1.0.4",
    "@iconify/json": "^2.2.464",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/alpinejs": "^3.13.11",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "autoprefixer": "^10.5.0",
    "daisyui": "^5.5.19",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "glob": "^13.0.6",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.2",
    "terser": "^5.46.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8"
  }
}
